# AfterMe Mobile Client Environment Configuration
# Use EXPO_PUBLIC_ prefix for client-accessible variables in Expo

# Backend API URL:
# - Android Emulator: http://10.0.2.2:3001
# - iOS Simulator / Local Web: http://localhost:3001
# - Physical Device on Local Wi-Fi: http://<YOUR_LAN_IP>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Default user ID for development sessions
EXPO_PUBLIC_DEFAULT_USER_ID=demo_user_001
